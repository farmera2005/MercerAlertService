{
  "name": "mercer-alert-service",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./apps/** --filter ./tools/** run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "db:generate": "pnpm --filter @mercer/db run generate",
    "db:migrate": "pnpm --filter @mercer/db run migrate",
    "db:seed": "pnpm --filter @mercer/db run seed",
    "dev:db": "docker compose up -d db",
    "dev:mock-swis": "pnpm --filter @mercer/mock-swis run dev",
    "dev:worker": "pnpm --filter @mercer/worker run dev",
    "dev:web": "pnpm --filter @mercer/web run dev",
    "swis:discover": "tsx scripts/swis-discover.ts",
    "swis:record": "tsx scripts/swis-record.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mercer/core": "workspace:*",
    "@mercer/db": "workspace:*",
    "@mercer/mock-swis": "workspace:*",
    "@mercer/swis": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}

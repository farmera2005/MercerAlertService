# ─────────────────────────────────────────────────────────────────────────────────────────────
# OPTIONAL. MercerAlertService needs NO configuration file: run `docker compose up -d` and finish
# setup in the browser (http://<vm>:3000). Everything below can be set in Settings instead.
#
# Use a .env file only for infrastructure-as-code. A variable set here OVERRIDES the web UI and
# shows as "set by environment" (locked) there. Any secret X may be given as a file instead:
# X_FILE=/run/secrets/<file>.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------- Docker Compose (host side)
# WEB_PORT=3000
# DB_PORT=5432
# APP_VERSION=dev
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=14
# BACKUP_HOST_DIR=./backups
# Pin the database password on FIRST start instead of generating one:
# POSTGRES_PASSWORD=
# Extra CA for building behind a TLS-inspecting proxy (path inside the project):
# BUILD_CA_FILE=./secrets/corp-ca.pem

# ---------------------------------------------------------------- generated automatically
# The `init` container writes these into the `bootstrap` volume; set them only to override.
# DATABASE_URL_FILE=/bootstrap/database_url
# MAS_MASTER_KEY_FILE=/bootstrap/master_key
# LOG_LEVEL=info
# TRUST_PROXY=false          # true when behind a reverse proxy that sets X-Forwarded-For

# ---------------------------------------------------------------- web UI: General
# APP_TIMEZONE=America/New_York
# APP_BASE_URL=https://netmon.mercer.local

# ---------------------------------------------------------------- web UI: SolarWinds connection
# SWIS_HOST=orion.mercer.local
# SWIS_PORT=17774
# SWIS_BASE_URL=                       # mock only, e.g. http://mock-swis:17774
# SWIS_USERNAME=svc-mas-ro
# SWIS_PASSWORD=
# SWIS_CA_CERT_PEM=                    # or SWIS_CA_CERT_PATH=/run/secrets/orion-ca.pem
# SWIS_TLS_SERVERNAME=SolarWinds-Orion
# SWIS_TLS_INSECURE_SKIP_VERIFY_DEV_ONLY=false
# SWIS_WRITEBACK_ENABLED=false
# SWIS_WRITE_USERNAME=
# SWIS_WRITE_PASSWORD=
# With SWIS_USERNAME and SWIS_PASSWORD set here, polling starts without the wizard.

# ---------------------------------------------------------------- web UI: Mapping
# CP_SITE_FIELD=Site
# CP_DIVISION_FIELD=Division
# CP_CITY_FIELD=City
# CP_ROLE_FIELD=
# SITE_FROM_CAPTION_REGEX=^([A-Za-z]{3,5})[-_]
# SITE_AUTO_CREATE=true

# ---------------------------------------------------------------- web UI: Polling
# SWIS_POLL_ALERTS_SEC=30
# SWIS_POLL_NODES_SEC=60
# SWIS_POLL_INTERFACES_SEC=180
# SWIS_POLL_EVENTS_SEC=300
# SWIS_POLL_TOPOLOGY_SEC=3600
# SWIS_STALE_AFTER_SEC=120
# SWIS_TIMEOUT_MS=20000
# SWIS_MAX_RETRIES=3
# SWIS_BREAKER_THRESHOLD=5
# SWIS_BREAKER_COOLDOWN_MS=30000
# SWIS_PAGE_SIZE=1000
# SWIS_NAIVE_TIMEZONE=UTC

# ---------------------------------------------------------------- web UI: Retention & self-monitoring
# RETENTION_RAW_DAYS=90
# RETENTION_INCIDENT_DAYS=730
# RETENTION_AUDIT_DAYS=730
# RETENTION_POLL_RUNS_DAYS=30
# RETENTION_CRON=15 3 * * *
# HEALTH_WORKER_STALE_SEC=60
# WORKER_HEARTBEAT_SEC=15
# DEADMAN_PING_URL=

# ---------------------------------------------------------------- web UI: AI (Claude) and digests
# Optional. Without a key, MAS uses its templates. The key is better entered in Settings → AI.
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# AI_ENABLED=true
# AI_REDACT=true
# AI_DAILY_BUDGET_USD=5
# AI_MODEL_STRONG=claude-opus-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# AI_PRIORITY_MODE=apply
# AI_SUMMARY_DEBOUNCE_SEC=45
# DIGEST_DAILY_CRON=0 7 * * *
# DIGEST_WEEKLY_CRON=30 7 * * 1
# DIGEST_CHANNEL=net-digest

# ─────────────────────────────────────────────────────────────────────────────────────────────
# OPTIONAL. MercerAlertService needs NO configuration file: run `docker compose up -d` and finish
# setup in the browser. Everything in the "web UI" blocks can be set in Settings instead.
#
# Use a .env file only for infrastructure-as-code. A variable set here OVERRIDES the web UI and
# shows as "set by environment" (locked) there. Any secret may be given as a file instead, as
# <NAME>_FILE=/run/secrets/<file>. Values shown are the defaults.
#
# Each description is on its own line on purpose: Compose reads "KEY=   # text" as the value
# "# text" when the value is empty, so never put a comment after a setting.
#
# Generated by `pnpm env:example` from packages/core/src/config (do not edit by hand).
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------- Docker Compose (host side)
# Dashboard port on the VM. Behind a reverse proxy on the same VM, use 127.0.0.1:3000 so only
# the proxy can reach it.
# WEB_PORT=3000
# Postgres port, always bound to 127.0.0.1 (for psql on the VM).
# DB_PORT=5432
# Published image version to run: latest (follows the default branch), v1.0.0, or sha-xxxxxxx.
# MAS_VERSION=latest
# Registry the images come from (a mirror or a private registry).
# MAS_REGISTRY=ghcr.io/farmera2005
# Version label baked into images you build yourself (docker compose build).
# APP_VERSION=dev
# Daily backup time (local time in APP_TIMEZONE) and how many days of dumps to keep.
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=14
# Where dumps are written on the VM, e.g. /mnt/mas-backups (a NAS share).
# BACKUP_HOST_DIR=./backups
# Pin the database password on FIRST start instead of generating one.
# POSTGRES_PASSWORD=
# Extra CA when building the images yourself behind a TLS-inspecting proxy (a path inside
# the project).
# BUILD_CA_FILE=./secrets/corp-ca.pem

# ---------------------------------------------------------------- environment only (not in the web UI)
# LOG_LEVEL=info
# (Compose sets DATABASE_URL_FILE=/bootstrap/database_url, written by the init container)
# DATABASE_URL=
# DATABASE_POOL_MAX=10
# SWIS_RETRY_BASE_MS=500
# SWIS_RETRY_MAX_MS=8000
# WORKER_HEALTH_PORT=9090
# (Compose sets MAS_MASTER_KEY_FILE=/bootstrap/master_key, written by the init container)
# MAS_MASTER_KEY=
# (local development only)
# MAS_DATA_DIR=
# (skip the wizard when everything is set here)
# MAS_SETUP_COMPLETE=false

# ---------------------------------------------------------------- web UI: General
# Time zone
# APP_TIMEZONE=America/New_York
# Dashboard URL
# APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- web UI: SolarWinds connection
# Orion server
# SWIS_HOST=orion.mercer.local
# SWIS port
# SWIS_PORT=17774
# Username
# SWIS_USERNAME=
# Password (secret)
# SWIS_PASSWORD=
# Base URL override
# SWIS_BASE_URL=

# ---------------------------------------------------------------- web UI: Orion certificate
# Trusted certificate (PEM)
# SWIS_CA_CERT_PEM=
# Certificate name
# SWIS_TLS_SERVERNAME=
# Certificate file path
# SWIS_CA_CERT_PATH=
# Skip certificate verification (development only)
# SWIS_TLS_INSECURE_SKIP_VERIFY_DEV_ONLY=false

# ---------------------------------------------------------------- web UI: Orion write-back (optional)
# Enable write-back
# SWIS_WRITEBACK_ENABLED=false
# Write-capable username
# SWIS_WRITE_USERNAME=
# Write-capable password (secret)
# SWIS_WRITE_PASSWORD=

# ---------------------------------------------------------------- web UI: Site & division mapping
# Find the site groups in SolarWinds automatically
# SITE_GROUP_AUTO=true
# Or: sites are the sub-groups of this group
# SITE_GROUP_PARENT=
# Or: site group names (regex)
# SITE_GROUP_PATTERN=
# Site custom property
# CP_SITE_FIELD=Site
# Division custom property
# CP_DIVISION_FIELD=Division
# City custom property
# CP_CITY_FIELD=City
# Device-role custom property (optional)
# CP_ROLE_FIELD=
# Site code from hostname
# SITE_FROM_CAPTION_REGEX=^([A-Za-z]{3,5})[-_]
# Create site profiles for unknown site values
# SITE_AUTO_CREATE=true

# ---------------------------------------------------------------- web UI: Polling
# Active alerts (seconds)
# SWIS_POLL_ALERTS_SEC=30
# Node status (seconds)
# SWIS_POLL_NODES_SEC=60
# Interfaces (seconds)
# SWIS_POLL_INTERFACES_SEC=180
# Events & alert history (seconds)
# SWIS_POLL_EVENTS_SEC=300
# Groups, site groups and site notes (seconds)
# SWIS_POLL_GROUPS_SEC=300
# Topology & dependencies (seconds)
# SWIS_POLL_TOPOLOGY_SEC=3600
# Raise “Monitoring source down” after (seconds)
# SWIS_STALE_AFTER_SEC=120
# Request timeout (ms)
# SWIS_TIMEOUT_MS=20000
# Retries per request
# SWIS_MAX_RETRIES=3
# Circuit breaker: failures before opening
# SWIS_BREAKER_THRESHOLD=5
# Circuit breaker: cool-down (ms)
# SWIS_BREAKER_COOLDOWN_MS=30000
# Rows per page
# SWIS_PAGE_SIZE=1000
# Rows per page (events)
# SWIS_INCREMENTAL_PAGE_SIZE=2000
# Events to backfill on first run
# SWIS_EVENTS_BACKFILL=2000
# Time zone of SWIS timestamps without an offset
# SWIS_NAIVE_TIMEZONE=UTC

# ---------------------------------------------------------------- web UI: Data retention
# Raw history (days)
# RETENTION_RAW_DAYS=90
# Incidents (days)
# RETENTION_INCIDENT_DAYS=730
# Audit log (days)
# RETENTION_AUDIT_DAYS=730
# “Ask the network” conversations (days)
# RETENTION_CHAT_DAYS=90
# Poll run log (days)
# RETENTION_POLL_RUNS_DAYS=30
# Purge schedule (cron)
# RETENTION_CRON=15 3 * * *

# ---------------------------------------------------------------- web UI: Correlation
# Group alerts at the same site within (seconds)
# CORRELATION_WINDOW_SEC=180
# Auto-resolve after all alerts clear for (seconds)
# RESOLVE_HOLDDOWN_SEC=300
# Reopen instead of a new incident within (seconds)
# REOPEN_WINDOW_SEC=900
# Flapping: state changes…
# FLAP_COUNT=4
# …within (minutes)
# FLAP_WINDOW_MIN=20
# UPS / power alert names (regex)
# UPS_ALERT_REGEX=battery|utility power|on bypass|\bups\b
# Ignore backlog older than (seconds)
# CORRELATION_MAX_AGE_SEC=3600

# ---------------------------------------------------------------- web UI: Priority scoring
# P1 at score ≥
# SCORING_P1_MIN=70
# P2 at score ≥
# SCORING_P2_MIN=50
# P3 at score ≥
# SCORING_P3_MIN=30
# Critical-tier site multiplier
# SCORING_TIER_CRITICAL=1.4
# High-tier site multiplier
# SCORING_TIER_HIGH=1.2
# Harvest multiplier for grain sites that are not harvest-critical
# SCORING_HARVEST_GRAIN_MULT=1.2
# Outside business hours multiplier
# SCORING_AFTER_HOURS_MULT=0.8
# Recovery target, harvest-critical site in harvest (minutes)
# RECOVERY_TARGET_HARVEST_MIN=240
# Recovery target, otherwise (minutes)
# RECOVERY_TARGET_DEFAULT_MIN=480

# ---------------------------------------------------------------- web UI: Microsoft sign-in (Entra ID)
# Directory (tenant) ID
# ENTRA_TENANT_ID=
# Application (client) ID
# ENTRA_CLIENT_ID=
# Client secret (secret)
# ENTRA_CLIENT_SECRET=
# Allowed security group (Object ID)
# ENTRA_ALLOWED_GROUP_ID=
# Admin group (Object ID, optional)
# ENTRA_ADMIN_GROUP_ID=
# Admin e-mail addresses (optional)
# BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------- web UI: Reverse proxy
# Behind a reverse proxy (trust X-Forwarded-For)
# TRUST_PROXY=false
# Number of proxies in front of MAS
# TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------- web UI: Map
# Map background
# MAP_MODE=tiles
# Tile URL
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Tile attribution
# MAP_ATTRIBUTION=© OpenStreetMap contributors
# Place sites from their address
# MAP_ADDRESS_LOOKUP=true
# Address lookup server
# MAP_GEOCODER_URL=https://nominatim.openstreetmap.org
# Look up addresses in
# MAP_GEOCODER_COUNTRIES=us

# ---------------------------------------------------------------- web UI: Wall display
# Seconds per view
# WALL_ROTATE_SEC=20
# Include the map view
# WALL_SHOW_MAP=true
# Stay on the incident list while a P1 is open
# WALL_PIN_P1=true

# ---------------------------------------------------------------- web UI: Notifications
# Shadow mode: send everything to the shadow channel and page nobody
# NOTIFY_SHADOW_MODE=true
# Shadow channel (Teams channel key)
# NOTIFY_SHADOW_CHANNEL=mas-shadow
# Page the on-call person even in shadow mode
# SHADOW_ALLOW_PAGING=false
# Quiet hours (optional)
# NOTIFY_QUIET_HOURS=
# Notify during quiet hours
# NOTIFY_QUIET_MIN_PRIORITY=P2
# Channel for MAS problems (failing notifiers, backlogs)
# NOTIFY_SELF_ALERT_CHANNEL=net-critical
# Allow http:// webhook URLs (testing with a local mock only)
# NOTIFY_ALLOW_HTTP=false

# ---------------------------------------------------------------- web UI: Paging & escalation
# Escalate when not acknowledged after (minutes)
# ESCALATE_AFTER_MIN=15
# At most this many pages per person per 15 minutes
# PAGE_RATE_LIMIT_PER_15MIN=5
# On-call week starts on
# ONCALL_HANDOFF_DAY=1
# Handoff time
# ONCALL_HANDOFF_TIME=08:00

# ---------------------------------------------------------------- web UI: Twilio SMS
# Account SID
# TWILIO_ACCOUNT_SID=
# Auth token (secret)
# TWILIO_AUTH_TOKEN=
# Send from
# TWILIO_FROM=
# API base URL
# TWILIO_API_BASE=https://api.twilio.com

# ---------------------------------------------------------------- web UI: Pushover
# Application API token (secret)
# PUSHOVER_APP_TOKEN=
# API base URL
# PUSHOVER_API_BASE=https://api.pushover.net

# ---------------------------------------------------------------- web UI: AI summaries (Claude)
# Anthropic API key (secret)
# ANTHROPIC_API_KEY=
# Use AI when a key is set
# AI_ENABLED=true
# Redact IP addresses, MAC addresses and serial numbers before sending
# AI_REDACT=true
# Priority suggestions
# AI_PRIORITY_MODE=apply
# Post the first AI summary to Teams as a follow-up card
# AI_POST_SUMMARY_UPDATE=true
# Notes about our network
# AI_ENVIRONMENT_NOTES=
# Offer “Ask the network” in the dashboard
# AI_CHAT_ENABLED=true
# Questions per person per hour
# AI_CHAT_PER_HOUR=30

# ---------------------------------------------------------------- web UI: AI models & limits
# Model for summaries and digests
# AI_MODEL_STRONG=claude-opus-5-5
# Model for priority checks
# AI_MODEL_FAST=claude-haiku-5-5
# Daily budget (US$)
# AI_DAILY_BUDGET_USD=5
# Give up on a call after (seconds)
# AI_TIMEOUT_SEC=90
# Wait before summarizing a change (seconds)
# AI_SUMMARY_DEBOUNCE_SEC=45
# Override: priority check model
# AI_MODEL_SEVERITY=
# Override: incident summary model
# AI_MODEL_SUMMARY=
# Override: digest model
# AI_MODEL_DIGEST=
# Override: “Ask the network” model
# AI_MODEL_CHAT=
# API base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------- web UI: Digests
# Post digests
# DIGEST_ENABLED=true
# Teams channel (key)
# DIGEST_CHANNEL=net-digest
# Daily digest schedule (cron, local time)
# DIGEST_DAILY_CRON=0 7 * * *
# Weekly trends schedule (cron, local time)
# DIGEST_WEEKLY_CRON=30 7 * * 1

# ---------------------------------------------------------------- web UI: Self-monitoring
# Worker heartbeat (seconds)
# WORKER_HEARTBEAT_SEC=15
# Treat the worker as down after (seconds)
# HEALTH_WORKER_STALE_SEC=60
# Dead-man’s switch URL
# DEADMAN_PING_URL=

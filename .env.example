# MercerAlertService configuration. Copy to .env and fill in. Never commit .env.
# Any secret X may instead be provided as a file: X_FILE=/run/mas-secrets/<file> (see secrets/README.md).

# ---------------------------------------------------------------- general
NODE_ENV=production
LOG_LEVEL=info
APP_TIMEZONE=America/New_York
# Public URL of the dashboard (used in Teams/SMS links from Milestone 4).
APP_BASE_URL=https://netmon.mercer.local
APP_VERSION=dev
WEB_PORT=3000

# ---------------------------------------------------------------- database
POSTGRES_DB=mas
POSTGRES_USER=mas
# Use a URL-safe value (e.g. `openssl rand -hex 24`); it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# DATABASE_URL is assembled by docker-compose.yml. For `pnpm dev:*` outside Docker:
# DATABASE_URL=postgres://mas:change-me@localhost:5432/mas
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- SolarWinds SWIS (read-only account)
SWIS_HOST=orion.mercer.local
SWIS_PORT=17774
# Overrides host/port, e.g. for the mock:  SWIS_BASE_URL=http://mock-swis:17774
# SWIS_BASE_URL=
SWIS_USERNAME=svc-mas-ro
SWIS_PASSWORD=change-me
# Orion's self-signed certificate (or issuing CA), exported as PEM into ./secrets/
SWIS_CA_CERT_PATH=/run/mas-secrets/orion-ca.pem
# Set if you connect by IP or a name not on the certificate:
# SWIS_TLS_SERVERNAME=orion.mercer.local
# DEVELOPMENT ONLY — disables certificate verification and logs an error every 10 minutes.
SWIS_TLS_INSECURE_SKIP_VERIFY_DEV_ONLY=false
SWIS_TIMEOUT_MS=20000
SWIS_MAX_RETRIES=3
SWIS_BREAKER_THRESHOLD=5
SWIS_BREAKER_COOLDOWN_MS=30000
SWIS_PAGE_SIZE=1000
# How SWIS timestamps without an offset are interpreted (confirm with `pnpm swis:discover`).
SWIS_NAIVE_TIMEZONE=UTC
# Raise "Monitoring source down" after this long without a successful alert poll.
SWIS_STALE_AFTER_SEC=120

# Poll intervals (seconds)
SWIS_POLL_ALERTS_SEC=30
SWIS_POLL_NODES_SEC=60
SWIS_POLL_INTERFACES_SEC=180
SWIS_POLL_EVENTS_SEC=300
SWIS_POLL_TOPOLOGY_SEC=3600

# Optional write-back (ack in MAS → ack in Orion). Needs a SEPARATE write-capable account.
SWIS_WRITEBACK_ENABLED=false
# SWIS_WRITE_USERNAME=svc-mas-rw
# SWIS_WRITE_PASSWORD=

# ---------------------------------------------------------------- site / division mapping
# Orion node custom-property names (confirm with `pnpm swis:discover`).
CP_SITE_FIELD=Site
CP_DIVISION_FIELD=Division
CP_CITY_FIELD=City
# Optional device-role property (values like Firewall, Core, AP, Scale, UPS):
CP_ROLE_FIELD=
# Fallback: site code from the hostname prefix (ROCK-FW01 → "ROCK").
SITE_FROM_CAPTION_REGEX=^([A-Za-z]{3,5})[-_]
SITE_AUTO_CREATE=true

# ---------------------------------------------------------------- retention
RETENTION_RAW_DAYS=90
RETENTION_POLL_RUNS_DAYS=30
RETENTION_INCIDENT_DAYS=730
RETENTION_AUDIT_DAYS=730
RETENTION_CRON=15 3 * * *

# ---------------------------------------------------------------- worker
WORKER_HEALTH_PORT=9090
WORKER_HEARTBEAT_SEC=15
# Optional external dead-man's switch (e.g. a healthchecks.io-style URL pinged every heartbeat).
# DEADMAN_PING_URL=
HEALTH_WORKER_STALE_SEC=60

# ---------------------------------------------------------------- backups (sidecar)
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups

# ---------------------------------------------------------------- later milestones (not used yet)
# M3 — Entra ID SSO
# AUTH_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
